# Copie para .docker/.env (não commitar): cp -n .docker/.env.example .docker/.env

PORT_INTERNAL=5173
PORT_EXTERNAL=5174

POSTGRES_INTERNAL=5432
POSTGRES_EXTERNAL=5434
POSTGRES_USER=inseminaai
POSTGRES_PASSWORD=inseminaai
POSTGRES_DB=inseminaai

# Dentro do compose (serviço app → db)
DATABASE_URL=postgresql://inseminaai:inseminaai@db:5432/inseminaai

# No host, só com `db` publicado: postgresql://inseminaai:inseminaai@localhost:5434/inseminaai

#gerar um hash openssl rand -base64 48
JWT_SECRET=dev-inseminaai-jwt-secret-32chars-min
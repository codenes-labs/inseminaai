{
  "name": "Insemina aí",
  "dockerComposeFile": ["${localWorkspaceFolder}/.docker/docker-compose.dev.yaml"],
  "service": "app",
  "workspaceFolder": "/app",
  "remoteUser": "node",
  "overrideCommand": true,
  "postCreateCommand": "bash .devcontainer/ensure-git-https-remote.sh && npm ci",
  "postStartCommand": "bash .devcontainer/ensure-git-https-remote.sh && bash .devcontainer/start-dev-server.sh",
  "postAttachCommand": "bash .devcontainer/ensure-git-https-remote.sh && bash .devcontainer/start-dev-server.sh",
  "forwardPorts": [5173, 5434],
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "GitHub.vscode-pull-request-github",
        "johnpapa.vscode-peacock"
      ],
      "settings": {
        "peacock.color": "#14532D",
        "peacock.affectTitleBar": true,
        "peacock.affectStatusBar": true,
        "git.useIntegratedAskPass": true
      }
    }
  }
}